# Required: dedicated MongoDB replica set or Atlas database (transactions for orders).
MONGODB_URI=mongodb://127.0.0.1:27017/dsmenu?replicaSet=rs0
# Required at runtime in production: canonical HTTP(S) origin for printed table QR URLs.
# No path/query/fragment; use https://dsmenu.com in production.
# Production: APP_URL and AUTH_URL must be the same canonical HTTPS origin.
APP_URL=http://localhost:3000
# Optional scheduled empty-table cleanup: random server-only secret (32+ characters).
# Configure your scheduler to GET /api/cron/empty-table-sessions with Bearer auth.
# Lazy cleanup at table entry and staff table reads also works without a scheduler.
CRON_SECRET=

# Required for staff login/dashboard only. Generate a random secret (32+ characters).
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# NEXTAUTH_URL is accepted as a legacy fallback when AUTH_URL is unset.
# Use separate credentials/databases for Vercel Production and Preview.
# Never prefix server credentials with NEXT_PUBLIC_. Vercel sets NODE_ENV.
# DSMENU_STAFF_PASSWORD is a temporary operator environment variable for
# create-user only; never configure it in Vercel or commit a staff password.

# Cloudinary: server-only; required only for image upload/removal.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Pusher Channels: configure all four for managed live updates.
# The browser receives only the key/cluster through an authorized server response.
# No NEXT_PUBLIC secret or build-time public variable is needed.
REALTIME_APP_ID=
REALTIME_KEY=
REALTIME_SECRET=
REALTIME_CLUSTER=
